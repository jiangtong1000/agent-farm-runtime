{"name": "squeue running", "squeue": {"available": true, "rc": 0, "stdout": "RUNNING\n"}, "sacct": {"available": true, "rc": 0, "stdout": ""}, "expect": {"state": "RUNNING", "terminal": false, "active": true}}
{"name": "squeue pending", "squeue": {"available": true, "rc": 0, "stdout": "PENDING\n"}, "sacct": {"available": true, "rc": 0, "stdout": ""}, "expect": {"state": "PENDING", "terminal": false, "active": true}}
{"name": "squeue completing", "squeue": {"available": true, "rc": 0, "stdout": "COMPLETING\n"}, "sacct": {"available": true, "rc": 0, "stdout": ""}, "expect": {"state": "COMPLETING", "terminal": false, "active": true}}
{"name": "left queue, sacct completed", "squeue": {"available": true, "rc": 0, "stdout": ""}, "sacct": {"available": true, "rc": 0, "stdout": "COMPLETED\n"}, "expect": {"state": "COMPLETED", "terminal": true, "active": false}}
{"name": "left queue, sacct failed", "squeue": {"available": true, "rc": 0, "stdout": ""}, "sacct": {"available": true, "rc": 0, "stdout": "FAILED\n"}, "expect": {"state": "FAILED", "terminal": true, "active": false}}
{"name": "left queue, sacct timeout", "squeue": {"available": true, "rc": 0, "stdout": ""}, "sacct": {"available": true, "rc": 0, "stdout": "TIMEOUT\n"}, "expect": {"state": "TIMEOUT", "terminal": true, "active": false}}
{"name": "left queue, sacct out of memory", "squeue": {"available": true, "rc": 0, "stdout": ""}, "sacct": {"available": true, "rc": 0, "stdout": "OUT_OF_MEMORY\n"}, "expect": {"state": "OUT_OF_MEMORY", "terminal": true, "active": false}}
{"name": "left queue, sacct cancelled by user", "squeue": {"available": true, "rc": 0, "stdout": ""}, "sacct": {"available": true, "rc": 0, "stdout": "CANCELLED by 12345\n"}, "expect": {"state": "CANCELLED", "terminal": true, "active": false}}
{"name": "left queue, sacct cancelled plus (dependency never satisfied)", "squeue": {"available": true, "rc": 0, "stdout": ""}, "sacct": {"available": true, "rc": 0, "stdout": "CANCELLED+\n"}, "expect": {"state": "CANCELLED+", "terminal": true, "active": false}}
{"name": "left queue, sacct node fail", "squeue": {"available": true, "rc": 0, "stdout": ""}, "sacct": {"available": true, "rc": 0, "stdout": "NODE_FAIL\n"}, "expect": {"state": "NODE_FAIL", "terminal": true, "active": false}}
{"name": "left queue, sacct empty (accounting lag)", "squeue": {"available": true, "rc": 0, "stdout": ""}, "sacct": {"available": true, "rc": 0, "stdout": ""}, "expect": {"state": null, "terminal": false, "active": false}}
{"name": "squeue error", "squeue": {"available": true, "rc": 1, "stdout": ""}, "sacct": {"available": true, "rc": 0, "stdout": "COMPLETED\n"}, "expect_pre_d6": {"state": null, "terminal": false, "active": false}, "expect": {"state": "COMPLETED", "terminal": true, "active": false}, "note": "D6: sacct must still be consulted when squeue fails"}
{"name": "squeue missing, sacct completed", "squeue": {"available": false, "rc": 0, "stdout": ""}, "sacct": {"available": true, "rc": 0, "stdout": "COMPLETED\n"}, "expect_pre_d6": {"state": null, "terminal": false, "active": false}, "expect": {"state": "COMPLETED", "terminal": true, "active": false}, "note": "D6: a host with only sacct must not stay UNKNOWN forever"}
{"name": "sacct error after leaving queue", "squeue": {"available": true, "rc": 0, "stdout": ""}, "sacct": {"available": true, "rc": 1, "stdout": ""}, "expect": {"state": null, "terminal": false, "active": false}}
{"name": "both missing", "squeue": {"available": false, "rc": 0, "stdout": ""}, "sacct": {"available": false, "rc": 0, "stdout": ""}, "expect": {"state": null, "terminal": false, "active": false}}
{"name": "squeue multiple lines (array aggregate)", "squeue": {"available": true, "rc": 0, "stdout": "RUNNING\nPENDING\n"}, "sacct": {"available": true, "rc": 0, "stdout": ""}, "expect": {"state": null, "terminal": false, "active": false}}
{"name": "sacct multiple lines", "squeue": {"available": true, "rc": 0, "stdout": ""}, "sacct": {"available": true, "rc": 0, "stdout": "COMPLETED\nFAILED\n"}, "expect": {"state": null, "terminal": false, "active": false}}
{"name": "squeue timeout exception", "squeue": {"available": true, "raise": "timeout"}, "sacct": {"available": true, "rc": 0, "stdout": "COMPLETED\n"}, "expect_pre_d6": {"state": null, "terminal": false, "active": false}, "expect": {"state": "COMPLETED", "terminal": true, "active": false}, "note": "D6"}
